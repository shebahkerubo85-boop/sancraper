{
  "version": 3,
  "sites": [
    {
      "id": "mkissa",
      "domains": ["mkissa.to"],
      "searchUrl": "https://mkissa.to/search/anime?query={query}",
      "discoveryOnly": true
    },
    {
      "id": "kurono",
      "domains": ["kurono.nl"],
      "searchUrl": "https://kurono.nl/?s={query}"
    },
    {
      "id": "anikura",
      "domains": ["anikura.club"],
      "searchUrl": "https://anikura.club/?s={query}"
    },
    {
      "id": "senshi",
      "domains": ["senshi.to"],
      "searchUrl": "https://senshi.to/search?q={query}",
      "api": {
        "catalogUrlTemplate": "https://senshi.to/episodes/{id}",
        "listPath": "$",
        "numberKey": "ep_id",
        "titleKey": "ep_title",
        "embedUrlTemplate": "https://senshi.to/episode-embeds/{id}/{episode}",
        "mediaKeys": ["url", "src", "file", "hls"],
        "referer": "https://senshi.to/"
      }
    },
    {
      "id": "anikoto",
      "domains": ["anikoto.cz"],
      "searchUrl": "https://anikoto.cz/?s={query}&post_type=wp_ser_post"
    },
    {
      "id": "hianime",
      "domains": ["hianime.at"],
      "searchUrl": "https://hianime.at/search?q={query}"
    }
  ]
}
